# Supabase: Transaction Pooler (porta 6543) para a API serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&schema=crm"
# Supabase: conexao direta ou Session Pooler (porta 5432) para migracoes.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:5432/postgres?sslmode=require&schema=crm"

JWT_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_INITIAL_PASSWORD="troque-esta-senha-antes-do-seed"
COMPANY_NAME="CRM JD"

# Dominio do frontend. Separe mais de uma origem com virgulas.
FRONTEND_URL="https://seu-frontend.vercel.app"
ALLOW_VERCEL_PREVIEWS="false"

# Redis e workers sao opcionais. Workers BullMQ permanentes devem rodar fora da Vercel.
# REDIS_URL="rediss://usuario:senha@host:porta"
ENABLE_QUEUE_WORKERS="false"

# Somente para PDF em desenvolvimento quando o Chrome nao for detectado.
# CHROME_EXECUTABLE_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
