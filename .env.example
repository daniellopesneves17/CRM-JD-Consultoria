# Configuração de exemplo do CRM. Copie para .env e troque todos os segredos antes de usar.

# === BANCO DE DADOS (SUPABASE + PRISMA) ===
# Use a URL do Session Pooler (porta 5432) no DATABASE_URL.
# Em producao, nunca envie estas URLs para o frontend ou para variaveis NEXT_PUBLIC_*.
# A senha precisa estar codificada para URL quando contiver caracteres especiais.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:5432/postgres?sslmode=require&schema=crm"
# Use a conexao direta, quando houver IPv6, ou repita o Session Pooler para as migracoes.
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:5432/postgres?sslmode=require&schema=crm"
REDIS_URL="redis://redis:6379"

# === AUTENTICAÇÃO ===
NEXTAUTH_SECRET="gere-uma-chave-aleatoria-de-32-chars"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="outra-chave-aleatoria-de-32-chars"

# === CORRETORA ===
COMPANY_NAME="CRM JD"

# === ADMINISTRADOR PROPRIETÁRIO ===
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# === URLS E EXECUÇÃO ===
BACKEND_URL="http://backend:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"
PORT="3001"
NODE_ENV="development"
