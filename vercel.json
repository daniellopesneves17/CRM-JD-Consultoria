{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 12 * * *"
    }
  ],
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "installCommand": "npm install",
      "outputDirectory": ".next"
    },
    "backend": {
      "root": "backend"
    }
  }
}
