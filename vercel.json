{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "crons": [
    { "path": "/api/cron/follow-up", "schedule": "0 * * * *" },
    { "path": "/api/cron/reactivation", "schedule": "0 12 * * *" },
    { "path": "/api/cron/score-update", "schedule": "0 */4 * * *" }
  ]
}
